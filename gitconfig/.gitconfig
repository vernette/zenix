[core]
  compression = 9
  whitespace = error
  preloadindex = true
  pager = hunk pager

[init]
  defaultBranch = master

[pull]
  default = current
  rebase = true

[rebase]
  autoStash = true
  missingCommitsCheck = warn

[status]
  branch = true
  short = true
  showStash = true
  showUntrackedFiles = all

[diff]
  context = 10
  renames = copies
  interHunkContext = 10

[merge]
  conflictstyle = zdiff3

[url "git@github.com:"]
  insteadOf = "gh:"
