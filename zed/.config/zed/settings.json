{
  // Proxy
  // "proxy": "http://127.0.0.1:3128",

  // Keymap
  "base_keymap": "VSCode",

  // Theme
  "theme": {
    "mode": "dark",
    "light": "Tokyo Night Light",
    "dark": "Tokyo Night",
  },
  "icon_theme": "Material Icon Theme",

  // Font
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_fallbacks": ["Noto Color Emoji", "Twemoji Country Flags"],
  "buffer_font_size": 15.0,
  "ui_font_family": ".ZedSans",
  "ui_font_size": 16.0,

  // Layout
  "project_panel": {
    "hide_root": true,
    "auto_reveal_entries": false,
    "auto_fold_dirs": false,
    "sticky_scroll": false,
  },
  "terminal": {
    "font_size": 18.0,
    "keep_selection_on_copy": false,
    "copy_on_select": true,
  },
  "agent": {
    "button": false,
  },
  "status_bar": {
    "cursor_position_button": false,
  },

  // UI
  "title_bar": {
    "show_onboarding_banner": false,
    "show_user_menu": false,
    "show_sign_in": false,
    "show_branch_status_icon": true,
  },
  "toolbar": {
    "quick_actions": false,
    "breadcrumbs": true,
  },
  "file_finder": {
    "modal_max_width": "small",
  },
  "indent_guides": {
    "enabled": true,
  },
  "cursor_animation": {
    "enabled": true,
  },
  "colorize_brackets": true,
  "current_line_highlight": "line",
  "show_whitespaces": "trailing",
  "inline_code_actions": false,

  // UX
  "restore_on_startup": "empty_tab",
  "when_closing_with_no_tabs": "keep_window_open",
  "autosave": "on_focus_change",
  "close_on_file_delete": true,
  "show_signature_help_after_edits": true,
  "auto_signature_help": true,
  "format_on_save": "on",
  // "vertical_scroll_margin": 10,
  // "horizontal_scroll_margin": 20,
  "drag_and_drop_selection": {
    "enabled": false,
  },
  "markdown_preview": {
    "open_markdown_files_in_preview": true,
  },

  // Vim
  "vim_mode": false,
  "vim": {
    "use_smartcase_find": true,
  },

  // Completions
  "completions": {
    "words": "fallback",
    "words_min_length": 2,
  },
  "completion_menu_item_kind": "symbol",

  // Predictions
  "edit_predictions": {
    "provider": "none",
  },

  // Diagnostics
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },

  // Search
  "search": {
    "center_on_match": true,
    "include_ignored": true,
    "button": false,
  },
  "use_smartcase_search": true,
  "seed_search_query_from_cursor": "selection",

  // Files
  "file_scan_exclusions": ["**/.venv", "**/.cache"],

  // Languages
  "languages": {
    "Python": {
      "language_servers": ["!zuban", "!pyright", "ruff", "basedpyright"],
      "format_on_save": "off",
      "ensure_final_newline_on_save": false,
      "remove_trailing_whitespace_on_save": false,
    },
    "Markdown": {
      "format_on_save": "off",
    },
    "YAML": {
      "format_on_save": "off",
    },
    "JSON": {
      "format_on_save": "off",
    },
  },

  // Extensions
  "auto_install_extensions": {
    // Theme
    "tokyo-night": true,
    "material-icon-theme": true,

    // LSP
    "html": true,
    "dockerfile": true,
    "lua": true,
    "ansible": true,
    "rst": true,
    "github-actions": true,
    "basher": true,
    "marksman": true,
    "zuban": true,

    // Treesitter
    "toml": true,
    "sql": true,
    "python-requirements": true,
    "caddyfile": true,
    "comment": true,

    // Snippets
    "python-snippets": true,
    "markdown-snippets": true,
  },

  // SSH
  "ssh_connections": [],

  // WSL
  "wsl_connections": [],

  // AI
  "language_models": {},

  // Telemetry
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },

  // Etc
  "auto_update": false,
}
